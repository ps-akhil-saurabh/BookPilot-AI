# ===== Application =====
APP_NAME=BookPilot AI
APP_VERSION=1.0.0
DEBUG=true
API_PREFIX=/api/v1

# ===== Server =====
HOST=0.0.0.0
PORT=8000

# ===== Database =====
DATABASE_URL=sqlite:///./bookpilot.db

# ===== ChromaDB =====
CHROMADB_PATH=./chromadb_data

# ===== LLM (Cloud API) =====
# Supported providers: Groq, Together AI, OpenRouter, or any OpenAI-compatible API
# Groq:      https://api.groq.com/openai/v1
# Together:  https://api.together.xyz/v1
# OpenRouter: https://openrouter.ai/api/v1
LLM_API_KEY=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
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_NAME=llama-3.1-70b-versatile
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ===== Embeddings =====
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ===== File Upload =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# ===== RAG =====
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5

# ===== Memory =====
MAX_SESSION_MESSAGES=20

# ===== Reflection =====
MAX_REFLECTION_LOOPS=3

# ===== Frontend =====
FRONTEND_URL=http://localhost:5173
